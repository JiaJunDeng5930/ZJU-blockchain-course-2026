{
  "name": "twopool-dex",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "^22.13.0 || ^24.0.0 || >=26.0.0"
  },
  "scripts": {
    "setup": "npm --prefix contracts ci && npm --prefix frontend ci",
    "dev": "node scripts/dev.mjs",
    "build": "npm --prefix contracts run compile && node scripts/generate-frontend-abi.mjs && npm run formal:build && npm --prefix frontend run build",
    "test": "npm --prefix contracts test",
    "formal:bootstrap": "node scripts/bootstrap-formal.mjs",
    "formal:build": "node scripts/build-formal.mjs",
    "deploy": "npm --prefix contracts run deploy",
    "formal:verify": "node scripts/verify-formal.mjs",
    "test:history": "npm run build && contracts/node_modules/.bin/tsx frontend/acceptance/history-public.mts",
    "test:activity": "npm run build && contracts/node_modules/.bin/tsx frontend/acceptance/activity-public.mts",
    "test:allowances": "npm run build && contracts/node_modules/.bin/tsx frontend/acceptance/allowances-public.mts",
    "test:precision": "npm run build && contracts/node_modules/.bin/tsx frontend/acceptance/precision-public.mts",
    "test:routing": "npm run build && contracts/node_modules/.bin/tsx frontend/acceptance/routing-public.mts",
    "test:replacements": "npm run build && contracts/node_modules/.bin/tsx frontend/acceptance/replacements-public.mts",
    "test:deadlines": "npm run build && contracts/node_modules/.bin/tsx frontend/acceptance/deadlines-public.mts",
    "test:simulation": "npm run build && contracts/node_modules/.bin/tsx frontend/acceptance/simulation-public.mts",
    "test:simulation-failure": "npm run build && contracts/node_modules/.bin/tsx frontend/acceptance/simulation-failure-public.mts",
    "test:arbitrage-evidence": "npm run build && contracts/node_modules/.bin/tsx frontend/acceptance/arbitrage-evidence-public.mts",
    "test:asset-setup": "npm run build && contracts/node_modules/.bin/tsx frontend/acceptance/asset-setup-public.mts",
    "test:creation-results": "npm run build && contracts/node_modules/.bin/tsx frontend/acceptance/creation-results-public.mts",
    "test:liquidity-evidence": "npm run build && contracts/node_modules/.bin/tsx frontend/acceptance/liquidity-evidence-public.mts",
    "test:initial-liquidity": "npm run build && contracts/node_modules/.bin/tsx frontend/acceptance/initial-liquidity-public.mts",
    "test:chain-read": "npm run build && contracts/node_modules/.bin/tsx frontend/acceptance/chain-read-public.mts"
  }
}
