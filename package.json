{
  "name": "twopool-dex",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "^22.13.0 || ^24.0.0 || >=26.0.0"
  },
  "scripts": {
    "setup": "npm --prefix contracts ci && npm --prefix frontend ci",
    "dev": "node scripts/dev.mjs",
