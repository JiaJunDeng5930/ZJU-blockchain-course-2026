    "test:pool-location": "npm run build && contracts/node_modules/.bin/tsx frontend/acceptance/pool-location-public.mts",
    "test:replacements": "npm run build && contracts/node_modules/.bin/tsx frontend/acceptance/replacements-public.mts",
    "test:deadlines": "npm run build && contracts/node_modules/.bin/tsx frontend/acceptance/deadlines-public.mts",
    "test:simulation": "npm run build && contracts/node_modules/.bin/tsx frontend/acceptance/simulation-public.mts",
    "test:simulation-failure": "npm run build && contracts/node_modules/.bin/tsx frontend/acceptance/simulation-failure-public.mts",
    "test:arbitrage-evidence": "npm run build && contracts/node_modules/.bin/tsx frontend/acceptance/arbitrage-evidence-public.mts",
    "test:arbitrage-capital": "npm run build && contracts/node_modules/.bin/tsx frontend/acceptance/arbitrage-capital-public.mts",
    "test:asset-setup": "npm run build && contracts/node_modules/.bin/tsx frontend/acceptance/asset-setup-public.mts",
    "test:wrapping-settlement": "npm run build && contracts/node_modules/.bin/tsx frontend/acceptance/wrapping-settlement-public.mts",
